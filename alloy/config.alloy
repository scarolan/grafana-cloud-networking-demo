// =============================================================================
// Grafana Alloy Configuration — Demo Builder Template
// =============================================================================
// This config ships telemetry to Grafana Cloud. The metrics remote_write block
// is active by default. Uncomment additional pipelines as needed.
//
// Credentials come from environment variables set in .env.
// All signals use the same GRAFANA_CLOUD_TOKEN — generate one at:
//   grafana.com → My Account → Access Policies → Generate token
// =============================================================================

// =============================================================================
// Metrics — Prometheus remote write to Grafana Cloud
// =============================================================================
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = env("GRAFANA_METRICS_URL")

    basic_auth {
      username = env("GRAFANA_METRICS_USERNAME")
      password = env("GRAFANA_CLOUD_TOKEN")
    }
  }
}

// Self-monitoring: scrape Alloy's own metrics so you can verify the pipeline
prometheus.scrape "alloy_self" {
  targets    = [{"__address__" = "localhost:12345"}]
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  scrape_interval = "15s"
  metrics_path    = "/metrics"
}

// Scrape simulated network device metrics from the generator
prometheus.scrape "network_devices" {
  targets    = [{"__address__" = "network-generator:9090"}]
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  scrape_interval = "15s"
  metrics_path    = "/metrics"
}

// =============================================================================
// Logs — Loki (collects Docker container logs including BGP/pool member events)
// =============================================================================
loki.write "grafana_cloud" {
  endpoint {
    url = env("GRAFANA_LOGS_URL")

    basic_auth {
      username = env("GRAFANA_LOGS_USERNAME")
      password = env("GRAFANA_CLOUD_TOKEN")
    }
  }
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_compose" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_compose.output
  forward_to = [loki.write.grafana_cloud.receiver]
}

